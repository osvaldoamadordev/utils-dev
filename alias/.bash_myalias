alias reload_zsh="source ~/.zshrc"             # reload ZSH
alias editar="code $HOME/.zshrc"
alias editalias="code $HOME/.bash_myalias"
alias cwd='pwd | pbcopy'                      #copy ruta
alias home="cd ~"                             #go the home user
alias HOME="cd ~"                             #go the home user
alias findd="ls | grep $1"

