#Mis alias OD0895
#-------------------------------------------------------------
# Aliases for Git.
#-------------------------------------------------------------
alias getrb="git checkout --track origin/$1"
alias gc="git clone"
alias glog="git log"
alias gstatus="git status"
alias g='git'
alias gamend="git commit --amend --no-edit"      #Commit changes onto previous commit.
alias gcommit="gitmoji -c"                      #Gitmoji commit standard.
alias gpull='git pull origin $(git_current_branch)'
alias gpush='git push origin $(git_current_branch)'
alias grv="git remote set-url origin"
alias gadd='git add .'
alias greset='git reset'
alias gstash='git stash'
alias gstashpop='git stash pop'
alias gnbranch="git checkout -b $1"
alias gcbranch="git checkout $1"f
alias glsb="git branch"
alias glogarbol="git log --graph --decorate --oneline"
alias deletecommitconcambios="git reset --soft HEAD~1"
alias godev="git checkout development"
alias gomain="git checkout main"
alias goprod="git checkout production"

#-------------------------------------------------------------
# Aliases for Proyects Market Place GLOBAL Caranty
#-------------------------------------------------------------
alias gpushmainmpsantander="git push origin_mpsantander main_mpsantander:main"
alias gpushdevmpsantander="git push origin_mpsantander develop_mpsantander:develop"


alias gpushprodmpcarpit="git push origin_mpcarpit main_mpcarpit:main"
alias gpushdevmpcarpit="git push origin_mpcarpit develop_mpcarpit:develop"

alias gpulldevmpcarpit='git pull origin_mpcarpit develop'
alias gpullprodmpcarpit='git pull origin_mpcarpit main'

alias gpulldevmpsantander='git pull origin_mpsantander develop'
alias gpullprodmpsantander='git pull origin_mpsantander main'

alias godevsantander="git checkout develop_mpsantander"
alias gomainsantander="git checkout main_mpsantander"

alias godevcarpit="git checkout develop_mpcarpit"
alias gomaincarpit="git checkout main_mpcarpit"

alias mergeprod="git checkout production && git merge develop"

# Will return the current branch name
# Usage example: git pull origin $(current_branch)
function current_branch() {
  ref=$(git symbolic-ref HEAD 2> /dev/null) || return
  echo ${ref#refs/heads/}
}

#-------------------------------------------------------------
# Aliases for PNPM, NPM and YARN
#-------------------------------------------------------------
alias ni="npm install"
alias pi="pnpm install"
alias yi="yarn"                               #Same thing as yarn install.
alias rmodule="rm -rf node_modules .yarn"     #removes node_modules folder for npm and pnpm. and .yarn for yarn.
alias ns="npm run start"
alias nsd="npm run start:dev"
alias nd="npm run dev"
alias npmy="npm init -y"
alias ndglobal="npm list -g --depth 0"
alias test_npm="npm run test"
alias ndz="npm run dev:zsh"
alias deletenodemodules="rm -rf node_modules"

