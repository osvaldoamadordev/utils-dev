#-------------------------------------------------------------
# Aliases for AI tools
#-------------------------------------------------------------
alias CODEX_OPEN="headroom wrap codex --dangerously-bypass-approvals-and-sandbox $1"
#alias OPEN_CLAUDE="headroom wrap claude --dangerously-skip-permissions $1"
# LOSSLESS=1: sin compresión con pérdida (con PROTECT=Bash solo, los cuerpos de skill y los ficheros pegados como mensaje seguían mutilados).
# --port 8788: wrap reutiliza el proxy que ya escucha en 8787, que arrancó sin estas variables; un puerto propio arranca uno que las hereda.

alias CLAUDE_OPEN="HEADROOM_PROTECT_TOOL_RESULTS=Bash CLAUDE_CODE_ENABLE_FUNCTION_HOOKS=1 HEADROOM_LOSSLESS=1 headroom wrap claude --port 8788 --dangerously-skip-permissions $1"
alias COPILOT_OPEN="copilot $1"
alias OPENCODE="headroom wrap opencode $1"
alias OPEN_GENTLE_SHELL="gentle-shell $1"

#-------------------------------------------------------------
# Aliases DOCKER.
#-------------------------------------------------------------
# Servicio Docker
alias docker_start='sudo systemctl start docker'
alias docker_stop='sudo systemctl stop docker.service docker.socket'
alias docker_restart='sudo systemctl restart docker'
alias docker_status='systemctl status docker --no-pager'
alias docker_enable='sudo systemctl enable --now docker'
alias docker_disable='sudo systemctl disable --now docker.service docker.socket'
alias docker_logs='sudo journalctl -u docker -f'

# Contenedores e imágenes
alias docker_ps='docker ps'
alias docker_pa='docker ps -a'
alias docker_stats='docker stats'
alias docker_images='docker images'
alias docker_volumes='docker volume ls'
alias docker_networks='docker network ls'

# Docker Compose
alias docker_cup='docker compose up -d'
alias docker_cdown='docker compose down'
alias docker_crestart='docker compose restart'
alias docker_cstop='docker compose stop'
alias docker_cstart='docker compose start'
alias docker_cps='docker compose ps'
alias docker_clogs='docker compose logs -f'

# Limpieza interactiva
alias docker_prune='docker system prune'

alias APAGAR_PC="sudo shutdown -h now"
alias REINICIAR_PC="sudo reboot"
alias DESACTIVAR_MODO_GRAFICO="sudo systemctl set-default multi-user.target && sudo reboot"
alias ACTIVAR_MODO_GRAFICO="sudo systemctl set-default graphical.target && sudo reboot"
alias ALMACENAMIENTO_N_RAM="df -h /var && free -h"

alias pbcopy='xclip -selection clipboard'
alias pbpaste='xclip -selection clipboard -o'


#-------------------------------------------------------------
# System
#-------------------------------------------------------------
alias apagar_wifi="sudo nmcli device disconnect wlp0s20f3"
alias encender_wifi="sudo nmcli device connect wlp0s20f3"
alias status_wifi="nmcli device status"
